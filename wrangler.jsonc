{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookdna",
  "main": "worker/src/main.py",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "production",
    "OPEN_LIBRARY_USER_AGENT": "BookDNA/0.1 (https://github.com/Vidyajagannathan/BookDNA)"
  },
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITY", "class_name": "IdentityDO" },
      { "name": "USERS", "class_name": "UserDO" },
      { "name": "CATALOG", "class_name": "CatalogShardDO" }
    ]
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "bookdna-catalog",
      "database_id": "89f8116a-a9d4-4e57-b0d6-28979f9e12a2",
      "migrations_dir": "migrations"
    }
  ],
  "exports": {
    "IdentityDO": { "type": "durable-object", "storage": "sqlite" },
    "UserDO": { "type": "durable-object", "storage": "sqlite" },
    "CatalogShardDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
